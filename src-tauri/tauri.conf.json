{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hizli Oku",
  "version": "0.3.0",
  "identifier": "io.github.hizlioku",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "windows": [
      {
        "title": "Hızlı Oku",
        "width": 1100,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "Education",
    "shortDescription": "Okuma antrenman programı",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
